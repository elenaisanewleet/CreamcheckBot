# ─────────────────────────────────────────────────────────────
# CreamcheckBot — переменные окружения
# Скопируй в .env и заполни. Всё, кроме первых двух строк, необязательно:
# без этих переменных бот работает ровно так же, как раньше.
# ─────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# ── Кто видит скрытые команды и дашборд ──────────────────────
# По умолчанию: Лена (41082373) и Лиза (228174255)
ADMIN_IDS=41082373,228174255

# ── Веб-дашборд ──────────────────────────────────────────────
# Открывается по адресу http://<сервер>:<PORT>/dash?key=<DASHBOARD_TOKEN>
# Если токен не задать, он сгенерируется при старте и попадёт в лог,
# но будет меняться при каждом перезапуске — лучше задать свой.
DASHBOARD_ENABLED=true
DASHBOARD_TOKEN=
# Публичный адрес сервера, чтобы команда /dash присылала рабочую ссылку
PUBLIC_BASE_URL=http://193.168.199.122:10000
PORT=10000

# ── Аналитика и логи ─────────────────────────────────────────
ANALYTICS_ENABLED=true
ANALYTICS_DB=/app/data/analytics.db
ANALYTICS_RETENTION_DAYS=180
LOG_LEVEL=INFO
LOG_FILE=/app/data/bot.log

# ── Кэш готовых разборов (скорость + экономия) ───────────────
CACHE_ENABLED=true
CACHE_TTL_DAYS=30
URL_CACHE_TTL_HOURS=72

# ── Скорость и стоимость запросов к модели ───────────────────
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_RETRIES=1

# Меньше веб-поисков = быстрее и дешевле. 10 — как было; 6 обычно достаточно.
STEP1_MAX_TOOL_CALLS=10
STEP1_MAX_OUTPUT_TOKENS=2500
# Пусто = дефолт модели. "low" заметно ускоряет ответ, но может чуть снизить
# качество поиска состава — включай только после проверки на своих примерах.
STEP1_REASONING_EFFORT=

# Шагу 2 веб-поиск почти не нужен (состав уже найден на шаге 1).
# false = дешевле и быстрее «Подробнее».
STEP2_WEB_SEARCH=true
STEP2_MAX_TOOL_CALLS=3
STEP2_MAX_OUTPUT_TOKENS=1200
STEP2_REASONING_EFFORT=

# ── Разбор состава по компонентам ────────────────────────────
# Кнопка «Что делает каждый компонент» под шагом 2: пояснение по каждому
# ингредиенту INCI, разложенное по функциональным группам.
# Считается только по нажатию и кэшируется на общих основаниях —
# повторный разбор того же состава бесплатен.
INGREDIENTS_ENABLED=true
# Веб-поиск здесь не роскошь: модель обязана искать всё, что не знает
# наверняка, вместо того чтобы вспоминать. Выключение повышает риск выдумок.
INGREDIENTS_WEB_SEARCH=true
INGREDIENTS_MAX_TOOL_CALLS=8
# Выход крупный: на каждый компонент идёт пояснение плюс открытый вопрос врачу.
# Ниже 4000 состав из 40 позиций может не поместиться целиком.
INGREDIENTS_MAX_OUTPUT_TOKENS=6000
INGREDIENTS_REASONING_EFFORT=

# ── Врач ─────────────────────────────────────────────────────
# Ник в Telegram без «собачки»: на него ведёт кнопка на экране
# «Что спросить у врача».
DOCTOR_USERNAME=DrDubinsky

# ── Фото ─────────────────────────────────────────────────────
# 0 = не сжимать (по умолчанию: мелкий шрифт состава читается лучше).
# Требует Pillow, если включать.
IMAGE_MAX_SIDE=0
IMAGE_JPEG_QUALITY=88

# Альбом из нескольких фото → один запрос к модели вместо нескольких
ALBUM_ENABLED=true
ALBUM_WAIT_SEC=1.5
ALBUM_MAX_PHOTOS=4

# ── Защита от лишних трат ────────────────────────────────────
SINGLE_FLIGHT_PER_USER=true
RATE_LIMIT_PER_HOUR=0
MAX_QUERY_LEN=300

# ── Цены для оценки расходов (USD за 1M токенов, gpt-5.2) ────
PRICE_IN_PER_1M=1.75
PRICE_CACHED_IN_PER_1M=0.175
PRICE_OUT_PER_1M=14.0
PRICE_WEB_SEARCH_PER_1K=10.0
